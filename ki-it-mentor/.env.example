# Kopiere nach .env NICHT nötig — die App liest Umgebungsvariablen beim Start.
# Echte Schlüssel gehören nie in Git, Logs oder Screenshots.
ANTHROPIC_API_KEY=
# Optional: Modell überschreiben (Standard: claude-opus-5-5)
KI_MENTOR_ANTHROPIC_MODEL=
# Optional: lokaler Ollama-Server (Standard: http://127.0.0.1:11434)
KI_MENTOR_OLLAMA_URL=
KI_MENTOR_OLLAMA_MODEL=
# Optional: Datenverzeichnis überschreiben (Standard: Electron userData)
KI_MENTOR_DATA_DIR=
